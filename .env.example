# Copiar para .env (que não vai para o GitHub) e mudar as palavras-passe.
#   cp .env.example .env

DB_NAME=perdidos_achados
DB_USER=perdidos
DB_PASSWORD=muda-esta-palavra-passe
DB_ROOT_PASSWORD=muda-tambem-esta
# Chave secreta para guardar os códigos de levantamento como hash (pelo menos 16 caracteres).
CODIGO_SEGREDO=muda-esta-chave-secreta
# Conta que o Galera usa para copiar os dados para um nó que entra no cluster.
GALERA_SST_PASSWORD=e-esta-tambem

# Backups automáticos para ./backups: de quanto em quanto tempo (segundos) e quantos guardar.
BACKUP_INTERVALO=3600
BACKUP_MANTER=24
